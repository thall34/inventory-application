<html>
    <head>
        <title><%= title %></title>
        <link rel="stylesheet" href="/app.css">
        <link rel="stylesheet" href="/index.css">
        <link rel="stylesheet" href="/rider.css">
    </head>
    <body>
        <%- include('./partials/header.ejs', { title: title }) %>
        <main> 
            <% if (!data || data.length === 0) { %>
                <h1>No riders logged yet</h1>
            <% } else { %>
                <ul class="rider-list">
                    <% data.map((rider) => { %>
                        <div class="rider-card">
                            <h2><%= rider.name %></h2>
                            <h3>Coasters (<%= rider.coasters.length %>):</h3>
                            <a href="/rider/<%= rider.rider_id %>">
                                <button>View More Info</button>
                            </a>
                            <a href="/rider/update/<%= rider.rider_id %>">
                                <button>Update Rider</button>
                            </a>
                            <a href="/rider/delete/<%= rider.rider_id %>">
                                <button>Delete rider</button>
                            </a>
                        </div>
                    <% }); %>
                </ul>
            <% } %>
            <a href="/rider/new">
                <button>New Rider</button>
            </a>
        </main>
        <%- include('./partials/footer.ejs') %>
    </body>
</html>