<html>
    <head>
        <title><%= title %></title>
    </head>
    <body>
        <%- include('./partials/header.ejs', { title: title }) %>
        <main> 
            <% if (!riders || riders.length === 0) { %>
                <p>No riders logged yet</p>
            <% } else { %>
                <ul>
                    <% riders.map((rider) => { %>
                        <h2><%= rider.name %></h2>
                        <h3>Coasters (<%= rider.coasters.length %>):</h3>
                        <% if (rider.coasters.length > 0) { %>
                            <ul>
                                <% rider.coasters.forEach((coaster) => { %>
                                    <li><%= coaster %></li>
                                <% }) %>
                            </ul>
                        <% } else { %>
                            <p>No coasters logged yet</p>
                        <% } %>
                        <a href="/rider/<%= rider.rider_id %>">
                            <button>View More Info</button>
                        </a>
                        <a href="/rider/update/<%= rider.rider_id %>">
                            <button>Update Rider</button>
                        </a>
                        <a href="/rider/delete/<%= rider.rider_id %>">
                            <button>Delete rider</button>
                        </a>
                    <% }); %>
                </ul>
            <% } %>
            <a href="/rider/new">
                <button>New Rider</button>
            </a>
        </main>
        <%- include('./partials/footer.ejs') %>
    </body>
</html>