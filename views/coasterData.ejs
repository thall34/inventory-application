<html>
    <head>
        <title><%= title %></title>
        <link rel="stylesheet" href="/app.css">
        <link rel="stylesheet" href="/index.css">
        <link rel="stylesheet" href="/coaster.css">
    </head>
    <body>
        <%- include('./partials/header.ejs', { title: title }) %>
        <main> 
            <ul class="coaster-card more-info">
                <h2><%= data.name %></h2>
                <li>Inversions: <%= data.inversions %></li>
                <li>Speed: <%= data.speed %>mph</li>
                <li>Height: <%= data.height %>ft</li>
                <li>Length: <%= data.length %>ft</li>
                <li>Park: <%= data.park_name %></li>
                <a href="/coaster/update/<%= data.coaster_id %>">
                    <button>Update Coaster</button>
                </a>
                <a href="/coaster/addToRider/<%= data.coaster_id %>">
                <button>Add Coaster to Rider</button>
            </a>
            </ul>
            <a href="/coaster">
                <button>Back to coaster list</button>
            </a>
        </main>
        <%- include('./partials/footer.ejs') %>
    </body>
</html>