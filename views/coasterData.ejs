<html>
    <head>
        <title><%= title %></title>
    </head>
    <body>
        <%- include('./partials/header.ejs', { title: title }) %>
        <main> 
            <ul>
                <h2><%= coaster.name %></h2>
                <li>Inversions: <%= coaster.inversions %></li>
                <li>Speed: <%= coaster.speed %>mph</li>
                <li>Height: <%= coaster.height %>ft</li>
                <li>Length: <%= coaster.length %>ft</li>
                <a href="/coaster/update/<%= coaster.id %>">
                    <button>Update Coaster</button>
                </a>
            </ul>
        </main>
        <%- include('./partials/footer.ejs') %>
    </body>
</html>