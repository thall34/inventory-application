<html>
    <head>
        <title><%= title %></title>
        <link rel="stylesheet" href="/app.css">
        <link rel="stylesheet" href="/index.css">
        <link rel="stylesheet" href="/coaster.css">
    </head>
    <body>
        <%- include('./partials/header.ejs', { title: title }) %>
        <main> 
            <ul class="coaster-card more-info">
                <h2><%= coaster.name %></h2>
                <li>Inversions: <%= coaster.inversions %></li>
                <li>Speed: <%= coaster.speed %>mph</li>
                <li>Height: <%= coaster.height %>ft</li>
                <li>Length: <%= coaster.length %>ft</li>
                <li>Park: <%= coaster.park_name %></li>
                <a href="/coaster/update/<%= coaster.coaster_id %>">
                    <button>Update Coaster</button>
                </a>
                <a href="/coaster/addToRider/<%= coaster.coaster_id %>">
                <button>Add Coaster to Rider</button>
            </a>
            </ul>
            <a href="/coaster">
                <button>Back to coaster list</button>
            </a>
        </main>
        <%- include('./partials/footer.ejs') %>
    </body>
</html>