<html>
    <head>
        <title><%= title %></title>
        <link rel="stylesheet" href="/styles.css">
    </head>
    <body>
        <%- include('./partials/header.ejs', { title: title }) %>
        <main> 
            <h2><%= rider.name %></h2>
            <h3>Coasters (<%= rider.coasters.length %>):</h3>
            <% if (rider.coasters.length > 0) { %>
                <ul>
                    <% rider.coasters.forEach((coaster) => { %>
                        <li><%= coaster %></li>
                    <% }) %>
                </ul>
            <% } else { %>
                <p>No coasters logged yet</p>
            <% } %>
            <a href="/rider/update/<%= rider.rider_id %>">
                <button>Update Rider</button>
            </a>
            <a href="/rider/addCoaster/<%= rider.rider_id %>">
                <button>Add Coaster to Rider</button>
            </a>
            <a href="/rider">
                <button>Back to rider list</button>
            </a>
        </main>
        <%- include('./partials/footer.ejs') %>
    </body>
</html>