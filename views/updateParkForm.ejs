<html>
    <head>
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title><%= title %></title>
        <link rel="stylesheet" href="/app.css">
        <link rel="stylesheet" href="/index.css">
        <link rel="stylesheet" href="/park.css">
    </head>
    <body>
        <%- include('./partials/header.ejs', { title: title }) %>
        <%- include('./partials/form_errors.ejs') %>
        <main> 
            <form action="<%= data.park_id %>" method="POST" class="park-form">
                <h2><%= title %></h2>
                <p>All fields marked with a <span class="red">*</span> are required</p>
                <label for="parkName">Name: <span class="red">*</span></label>
                <input type="text" name="parkName" id="parkName" value="<%= data.name %>" required>
                <button type="submit">Submit</button>
            </form>
        </main>
        <%- include('./partials/footer.ejs') %>
    </body>
</html>