<html>
    <head>
        <title><%= title %></title>
    </head>
    <body>
        <%- include('./partials/header.ejs', { title: title }) %>
        <main> 
            <form action="<%= rider.rider_id %>" method="POST">
                <h2>Add coaster to <%= rider.name %></h2>
                <label for="coasterName">Name: </label>
                <input type="text" name="coasterName" id="coasterName" required>
                <button type="submit">Submit</button>
            </form>
        </main>
        <%- include('./partials/footer.ejs') %>
    </body>
</html>