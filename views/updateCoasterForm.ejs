<html>
    <head>
        <title><%= title %></title>
    </head>
    <body>
        <%- include('./partials/header.ejs', { title: title }) %>
        <main> 
            <form action="<%= coaster.coaster_id %>" method="POST">
                <h2><%= title %></h2>
                <label for="coasterName">Name: </label>
                <input type="text" name="coasterName" id="coasterName" value="<%= coaster.name %>" required>
                <label for="parkName">Park name: </label>
                <input type="text" name="parkName" id="parkName" value="<%= coaster.park_name %>">
                <label for="coasterInversions">Inversions: </label>
                <input type="number" name="coasterInversions" id="coasterInversions" min="0" value="<%= coaster.inversions %>" required>
                <label for="coasterSpeed">Speed(mph): </label>
                <input type="number" name="coasterSpeed" id="coasterSpeed" min="0" value="<%= coaster.speed %>" required>
                <label for="coasterHeight">Height(ft): </label>
                <input type="number" name="coasterHeight" id="coasterHeight" min="0" value="<%= coaster.height %>" required>
                <label for="coasterLength">Length(ft): </label>
                <input type="number" name="coasterLength" id="coasterLength" min="0" value="<%= coaster.length %>" required>
                <button type="submit">Submit</button>
            </form>
        </main>
        <%- include('./partials/footer.ejs') %>
    </body>
</html>