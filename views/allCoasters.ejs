<html>
    <head>
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title><%= title %></title>
        <link rel="stylesheet" href="/app.css">
        <link rel="stylesheet" href="/index.css">
        <link rel="stylesheet" href="/coaster.css">
        
    </head>
    <body>
        <%- include('./partials/header.ejs', { title: title }) %>
        <main> 
            <% if (!data || data.length === 0) { %>
                <h1>No coasters logged yet</h1>
            <% } else { %>
                    <ul class="coaster-list">
                        <% data.map((coaster) => { %>
                            <div class="coaster-card">
                                <h2><%= coaster.name %></h2>
                                <li>Park: <%= coaster.park_name %></li>
                                <a href="/coaster/<%= coaster.coaster_id %>">
                                    <button>View More Info</button>
                                </a>
                                <a href="/coaster/update/<%= coaster.coaster_id %>">
                                    <button>Update Coaster</button>
                                </a>
                                <a href="/coaster/delete/<%= coaster.coaster_id %>">
                                    <button>Delete Coaster</button>
                                </a>
                            </div>
                        <% }); %>
                    </ul>
            <% } %>
            <a href="/coaster/new">
                <button>New Coaster</button> 
            </a>
        </main>
        <%- include('./partials/footer.ejs') %>
    </body>
</html>