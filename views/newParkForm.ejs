<html>
    <head>
        <title><%= title %></title>
        <link rel="stylesheet" href="/app.css">
        <link rel="stylesheet" href="/index.css">
        <link rel="stylesheet" href="/park.css">
    </head>
    <body>
        <%- include('./partials/header.ejs', { title: title }) %>
        <%- include('./partials/form_errors.ejs') %>
        <main> 
            <form action="new" method="POST" class="park-form">
                <h2>New Park</h2>
                <p>All fields marked with an <span class="red">*</span> are required</p>
                <label for="parkName">Name: <span class="red">*</span></label>
                <input type="text" name="parkName" id="parkName" required>
                <button type="submit">Submit</button>
            </form>
        </main>
        <%- include('./partials/footer.ejs') %>
    </body>
</html>