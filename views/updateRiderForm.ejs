<html>
    <head>
        <title><%= title %></title>
        <link rel="stylesheet" href="/app.css">
        <link rel="stylesheet" href="/index.css">
        <link rel="stylesheet" href="/rider.css">
    </head>
    <body>
        <%- include('./partials/header.ejs', { title: title }) %>
        <%- include('./partials/form_errors.ejs') %>
        <main> 
            <form action="<%= rider.rider_id %>" method="POST" class="rider-form">
                <h2><%= title %></h2>
                <p>All fields marked with an <span class="red">*</span> are required</p>
                <label for="riderName">Name: <span class="red">*</span></label>
                <input type="text" name="riderName" id="riderName" value="<%= rider.name %>" required>
                <button type="submit">Submit</button>
            </form>
        </main>
        <%- include('./partials/footer.ejs') %>
    </body>
</html>