<html>
    <head>
        <title><%= title %></title>
        <link rel="stylesheet" href="/app.css">
        <link rel="stylesheet" href="/index.css">
        <link rel="stylesheet" href="/park.css">
    </head>
    <body>
        <%- include('./partials/header.ejs', { title: title }) %>
        <main> 
            <% if (!data || data.length === 0) { %>
                <h1>No parks logged yet</h1>
            <% } else { %>
                <ul class="park-list">
                    <% data.map((park) => { %>
                        <div class="park-card">
                            <h2><%= park.name %></h2>
                            <h3>Coasters (<%= park.coasters.length %>) </h3>
                            <a href="/park/<%= park.park_id %>">
                                <button>View More Info</button>
                            </a>
                            <a href="/park/update/<%= park.park_id %>">
                                <button>Update Park</button>
                            </a>
                            <a href="/park/delete/<%= park.park_id %>">
                                <button>Delete Park</button>
                            </a>
                        </div>
                    <% }); %>
                </ul>
            <% } %>
            <a href="/park/new">
                <button>New Park</button>
            </a>
        </main>
        <%- include('./partials/footer.ejs') %>
    </body>
</html>